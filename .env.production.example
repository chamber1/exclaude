# Production settings for docker-compose.prod.yml. Copy to .env on the server, fill in every
# empty value, keep the file readable only by the deploy user: chmod 600 .env
# See docs/DEPLOYMENT.md.

APP_NAME=exclaude
APP_ENV=production
# Generate once: docker compose -f docker-compose.prod.yml run --rm --no-deps app php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
# Your domain without scheme (nginx server_name and certificate path); APP_URL is the same with https://.
APP_DOMAIN=example.com
APP_URL=https://example.com
# Image tag built and started by docker compose (e.g. the git commit); see "Updating".
APP_VERSION=latest

LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# Load balancer / CDN in front of this server (comma-separated IPs/CIDRs). Empty when clients connect directly.
TRUSTED_PROXIES=

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=exclaude
DB_USERNAME=exclaude
# Long random values, e.g. openssl rand -base64 32 | tr -d '/+='
DB_PASSWORD=
DB_ROOT_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Must be greater than the job timeout (660 s).
REDIS_QUEUE_RETRY_AFTER=900

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
FILESYSTEM_DISK=local
BROADCAST_DRIVER=log

# Parallel downloads = number of queue-worker containers.
QUEUE_WORKERS=2

# Downloads — all options and defaults: config/downloads.php
DOWNLOADS_X_ACCEL_PREFIX=/_protected/downloads
# any | creative_commons (only videos published under a Creative Commons licence)
DOWNLOADS_LICENSE_POLICY=any
DOWNLOADS_LOG_LEVEL=info
DOWNLOADS_MAX_DURATION=3600
DOWNLOADS_FILE_TTL=3600
DOWNLOADS_MAX_QUEUED=100
DOWNLOADS_RETENTION_DAYS=30
DOWNLOADS_GUEST_ACTIVE=1
DOWNLOADS_GUEST_PER_MINUTE=3
DOWNLOADS_GUEST_PER_DAY=10
DOWNLOADS_GUEST_MAX_HEIGHT=720
DOWNLOADS_GUEST_MAX_FILESIZE=500M
DOWNLOADS_FREE_PER_DAY=50
DOWNLOADS_PREMIUM_PER_DAY=500

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
